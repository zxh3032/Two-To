# Two-To API 基础配置
TWO_TO_APP_NAME=two-to-api
TWO_TO_ENV=development
TWO_TO_HTTP_ADDR=:0806
TWO_TO_LOG_LEVEL=debug
TWO_TO_CORS_ALLOW_ORIGINS=

# 本地没有 MySQL 时可以先留空，服务会跳过数据库初始化并保留健康检查。
# 示例：two_to:password@tcp(127.0.0.1:3306)/two_to?charset=utf8mb4&parseTime=True&loc=Local
TWO_TO_MYSQL_DSN=

# 登录态配置。生产环境必须改成高强度随机密钥。
TWO_TO_ACCESS_TOKEN_SECRET=two-to-dev-access-secret
TWO_TO_ACCESS_TOKEN_TTL_SECONDS=900
TWO_TO_REFRESH_TOKEN_SECRET=two-to-dev-refresh-secret
TWO_TO_REFRESH_TOKEN_TTL_SECONDS=2592000

# 验证码与短期流程配置。
TWO_TO_CAPTCHA_TTL_SECONDS=300
TWO_TO_VERIFICATION_CODE_TTL_SECONDS=600
TWO_TO_CODE_RESEND_COOLDOWN_SECONDS=60
TWO_TO_PROFILE_SETUP_TTL_SECONDS=600
TWO_TO_PASSWORD_RESET_TTL_SECONDS=600
TWO_TO_CODE_TARGET_HOURLY_LIMIT=5
TWO_TO_CODE_TARGET_DAILY_LIMIT=10
TWO_TO_CODE_IP_HOURLY_LIMIT=30
TWO_TO_VERIFICATION_CODE_MAX_ATTEMPTS=5
TWO_TO_LOGIN_CAPTCHA_FAIL_THRESHOLD=3
TWO_TO_LOGIN_LOCK_FAIL_THRESHOLD=5
TWO_TO_LOGIN_LOCK_TTL_SECONDS=900

# 本地可以用 memory 免 Redis 启动；联调/生产建议切到 redis。
TWO_TO_CACHE_DRIVER=memory
TWO_TO_REDIS_ADDR=127.0.0.1:6379
TWO_TO_REDIS_USERNAME=
TWO_TO_REDIS_PASSWORD=
TWO_TO_REDIS_DB=0
TWO_TO_REDIS_KEY_PREFIX=two-to

# 邮件验证码，未配置 SMTP 时本地会使用 mock 并在日志中输出验证码。
TWO_TO_SMTP_HOST=
TWO_TO_SMTP_PORT=587
TWO_TO_SMTP_USERNAME=
TWO_TO_SMTP_PASSWORD=
TWO_TO_SMTP_FROM=
TWO_TO_SMTP_FROM_NAME=Two-To

# 短信验证码，本地默认 mock；生产按主备配置 aliyun / volcengine。
TWO_TO_SMS_PRIMARY_PROVIDER=mock
TWO_TO_SMS_BACKUP_PROVIDER=

TWO_TO_ALIYUN_SMS_ACCESS_KEY_ID=
TWO_TO_ALIYUN_SMS_ACCESS_KEY_SECRET=
TWO_TO_ALIYUN_SMS_SIGN_NAME=
TWO_TO_ALIYUN_SMS_TEMPLATE_CODE=
TWO_TO_ALIYUN_SMS_REGION_ID=cn-hangzhou

TWO_TO_VOLCENGINE_SMS_ACCESS_KEY_ID=
TWO_TO_VOLCENGINE_SMS_ACCESS_KEY_SECRET=
TWO_TO_VOLCENGINE_SMS_SIGN_NAME=
TWO_TO_VOLCENGINE_SMS_TEMPLATE_ID=
TWO_TO_VOLCENGINE_SMS_SMS_ACCOUNT=
TWO_TO_VOLCENGINE_SMS_REGION_ID=cn-north-1
